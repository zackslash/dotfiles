{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "dark"
  },
  "plugins": [
    {
      "package": "vimcode@git+https://github.com/oribarilan/vimcode.git#v0.19.2",
      "options": {
        "updateCheck": false,
        "modeIndicator": "none",
        "startMode": "insert"
      }
    }
  ],
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "enabled": false
  }
}
