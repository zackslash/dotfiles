#!/usr/bin/env bash
# sunshine-wake-watcher — wake the display the moment a Moonlight client
# connects to Sunshine, so the launch-time encoder probe sees a monitor.
#
# Why this exists: Sunshine validates capture/encoders BEFORE running app
# prep-cmds. With the screen asleep the KMS monitor list is empty and the
# launch dies with "Couldn't find monitor [0]" / "Fatal: Unable to find
# display or encoder" — a prep-cmd wake never gets to run (verified in
# sunshine.log.3, 2026-10-06 22:31). Moonlight talks to Sunshine's HTTPS
# API on 47990 (/serverinfo before every launch), and the launch
# connection stays open for the whole encoder sweep, so this poll always
# catches it in time for the retry even in the worst case.
#
# Guards:
#   - fires on the rising edge only (idle -> connected), never while a
#     connection is already up
#   - never wakes while /tmp/sunshine-streaming exists (live session —
#     no stray Ctrl taps mid-game)
#   - only taps when every connected display is actually asleep
#     (drm connector dpms=Off) — no input is injected while someone
#     is using the machine
#   - 10s cooldown between wakes
# Every wake is printed to stdout and lands in the journal.

set -u

PORT=47990
WAKE="$HOME/scripts/wake"
COOLDOWN=10
STREAM_MARKER=/tmp/sunshine-streaming

# True when no connected DRM connector is powered on, i.e. every physical
# display is blanked/off. A blanked COSMIC output loses its CRTC (which is
# why Sunshine's probe fails), and a connector without an active CRTC reads
# dpms=Off in sysfs. Unreadable sysfs fails open (treat as asleep) so the
# wake keeps working even if this check ever breaks.
screen_asleep() {
    local c
    for c in /sys/class/drm/card*-*/; do
        [ -r "$c/status" ] && [ -r "$c/dpms" ] || continue
        [ "$(cat "$c/status")" = connected ] || continue
        if [ "$(cat "$c/dpms")" = On ]; then
            return 1
        fi
    done
    return 0
}

prev_up=0
last_wake=0

while :; do
    # Any socket on Sunshine's API port except LISTEN and loopback peers.
    # Includes established + syn-recv + close/fin-wait so short-lived
    # requests aren't missed (time-wait excluded so retries re-edge).
    # Columns: State Recv-Q Send-Q Local Peer -> peer is $5.
    peers=$(ss -tHn "( sport = :$PORT )" 2>/dev/null \
        | awk '$1 != "LISTEN" {print $5}' \
        | grep -vE '^(127\.|\[::1\])' \
        | sort -u)

    up=0
    [ -n "$peers" ] && up=1

    if [ "$up" = 1 ] && [ "$prev_up" = 0 ]; then
        now=$(date +%s)
        if (( now - last_wake >= COOLDOWN )) && [ ! -e "$STREAM_MARKER" ]; then
            if screen_asleep; then
                echo "$(date '+%F %T') moonlight client connected ($peers) - waking display"
                if ! "$WAKE" >/dev/null 2>&1; then
                    echo "$(date '+%F %T') WARNING: $WAKE exited non-zero"
                fi
            else
                echo "$(date '+%F %T') moonlight client connected ($peers) - screen already on, skipping wake"
            fi
            last_wake=$now
        fi
    fi

    prev_up=$up
    sleep 0.5
done
