#!/usr/bin/env bash
# Lock/unlock the COSMIC session around Steam Remote Play.
#
# Steam has no host-side hooks for Remote Play, so we tail two of its
# logs:
#   streaming_log.txt       "Streaming started to <client>"  -> unlock
#   remote_connections.txt  "Client <id> (<name>) disconnected: <reason>" -> lock
#
# Why presence, not ">>> Stopped desktop stream": that marker only means
# the *desktop capture surface* ended. Steam also writes it MID-SESSION
# when switching between desktop and in-game overlay capture
# ("Switching video stream ... GameOverlay_MovieStream"), which
# lock-spammed the user mid-game (2026-10-12 incident, 5 locks in 3min).
# Presence ("Client ... disconnected") spans the whole client session:
# capture switches and sub-10s reconnect blips do NOT flap it.
# Lock is debounced (LOCK_DELAY quiet seconds) and cancelled by any new
# stream start, so a client that reconnects and resumes never gets
# flash-locked.
#
# cosmic-greeter consumes the logind Unlock/Lock signals without a
# password (verified against cosmic-greeter epoch-1.9.1 src/logind.rs +
# src/locker.rs, 2026-10-11).
#
# IMPORTANT: use `loginctl {un,}lock-session <seat0-id>` (singular), NOT
# the plural/manager variants. Those are polkit-gated with
# auth_admin_keep; the auth dialog can never be approved under the lock
# surface, so the call hangs 25s and dies with
# "Could not lock sessions: Connection timed out" (verified live).
#
# Deliberately does NOT wake or darken the physical display - the local
# screen state is left to the user and cosmic-idle.
#
# After unlock, every open window is minimized (cosmic-minimize-all) so
# the stream shows a clean desktop until the game takes the screen.
# Unconditional, like the unlock itself: LockedHint proved unreliable
# (locks via cosmic-greeter directly - idle timeout or shortcut - never
# set it; failed live test 2026-11-07). Minimize runs BEFORE the unlock
# call so the compositor hides windows behind the lock surface while it
# is still up.
#
# On client disconnect the session relocks, and the windows minimized
# for the stream are restored BEHIND the lock surface (matched by
# app_id+title via STATE_FILE - not Wayland object ids, which are
# per-connection). Windows the user minimized themselves stay minimized.
#
# Sunshine/Moonlight streams are unaffected: those are handled by
# Sunshine prep-cmds (see apps.json) and never reach these logs.
set -u

SLOG="$HOME/.local/share/Steam/logs/streaming_log.txt"
RLOG="$HOME/.local/share/Steam/logs/remote_connections.txt"
LOCK_DELAY=4   # quiet seconds after a disconnect before locking
MINIMIZE_ALL="$HOME/scripts/cosmic-minimize-all"
STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/steam-unlock.minimized"

for cmd in tail sed cat loginctl awk id; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "FATAL: $cmd not found"; exit 1; }
done

graphical_session_id() {
    loginctl list-sessions --no-legend 2>/dev/null \
        | awk -v u="$(id -un)" '$3 == u && $4 == "seat0" { print $1; exit }'
}

session_action() {  # session_action unlock|lock
    local action=$1 sid
    sid=$(graphical_session_id)
    if [ -z "$sid" ]; then
        echo "no seat0 session found - cannot ${action} session"
        return 1
    fi
    loginctl "${action}-session" "$sid" || echo "${action}-session $sid failed (exit $?)"
}

unlock_and_clear_desktop() {
    local sid
    sid=$(graphical_session_id)
    if [ -z "$sid" ]; then
        echo "no seat0 session found - cannot unlock session"
        return 1
    fi
    # Merge, never overwrite: a reconnect blip re-enters this arm with
    # the desktop already minimized, so the new run records nothing -
    # overwriting would destroy the pre-stream window list. Duplicates
    # are harmless: restore matches a set and only touches handles that
    # are still minimized.
    if [ -f "$MINIMIZE_ALL" ]; then
        if python3 "$MINIMIZE_ALL" --remember-minimize > "$STATE_FILE.new"; then
            { [ -f "$STATE_FILE" ] && cat "$STATE_FILE"; cat "$STATE_FILE.new"; } > "$STATE_FILE.tmp" \
                && mv -f "$STATE_FILE.tmp" "$STATE_FILE"
            rm -f "$STATE_FILE.new"
            echo "cleared desktop for stream ($(wc -l < "$STATE_FILE") windows recorded)"
        else
            echo "minimize failed (exit $?) - $STATE_FILE left as-is"
            rm -f "$STATE_FILE.new"
        fi
    fi
    loginctl unlock-session "$sid" || echo "unlock-session $sid failed (exit $?)"
}

restore_windows() {
    # Put back exactly the pre-stream window set, behind the lock
    # surface. STATE_FILE holds one "app_id<TAB>title" line per window
    # the stream start minimized; it survives service restarts. On
    # restore failure the file is KEPT so the next disconnect retries.
    if [ -f "$MINIMIZE_ALL" ] && [ -s "$STATE_FILE" ]; then
        if python3 "$MINIMIZE_ALL" --restore-remembered < "$STATE_FILE"; then
            rm -f "$STATE_FILE"
        else
            echo "restore failed (exit $?) - keeping $STATE_FILE"
        fi
    else
        rm -f "$STATE_FILE"   # missing or empty: nothing to restore
    fi
}

echo "watching Steam streaming + remote-connection logs"

pending_lock=0

# Two tagged, unbuffered tails merged into one stream. -n0 starts at EOF
# so service restarts never replay old events; -F survives Steam's log
# rotation and restarts. sed -u keeps lines unbuffered so events are seen
# immediately (sed full-buffers when writing to a pipe).
#
# The loop must be unconditional: a timed-out `read -t` returns failure,
# which would terminate a `while read -t` loop after the first quiet
# window (that bug crash-looped the unit every LOCK_DELAY+3s). Instead,
# read's failure is the quiet tick that lets a pending lock fire.
while :; do
    # rc MUST be captured on the read itself: `if ! read` would put the
    # NEGATED status (always 0) into $?, and the EOF guard below would
    # be dead code - both tails dying would hot-spin instead of exiting
    # for systemd to restart us.
    line=""
    IFS= read -r -t "$LOCK_DELAY" line
    rc=$?
    if [ "$rc" -eq 1 ] && [ -z "$line" ]; then
        echo "FATAL: log pipe EOF (tail died)"
        exit 1
    fi
    if [ "$rc" -ne 0 ]; then
        # timeout tick: no log lines for LOCK_DELAY seconds
        line=""
    fi
    if [ -z "$line" ]; then
        if [ "$pending_lock" -eq 1 ]; then
            pending_lock=0
            echo "Remote Play client disconnected - locking session"
            session_action lock
            restore_windows
        fi
        continue
    fi

    case "$line" in
    "[S] "*"Streaming started to"*)
        peer="${line##*Streaming started to }"
        pending_lock=0
        echo "Remote Play stream started (${peer}) - unlocking session"
        unlock_and_clear_desktop
        ;;
    "[S] "*"Initializing streaming"*)
        # new stream warming up - cancel any pending lock
        pending_lock=0
        ;;
    "[P] "*" disconnected: "*)
        echo "Remote Play client presence ended (${line#"[P] "})"
        pending_lock=1
        ;;
    esac
done < <(
    tail -n0 -F "$SLOG" 2>/dev/null | sed -u 's/^/[S] /' &
    tail -n0 -F "$RLOG" 2>/dev/null | sed -u 's/^/[P] /' &
    wait
)
